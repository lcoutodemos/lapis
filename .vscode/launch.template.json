{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Electron (dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "affine",
        "@affine/electron",
        "dev"
      ]
    },
    {
      "name": "Launch Electron Renderer (dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "affine",
        "@affine/electron-renderer",
        "dev"
      ]
    }
  ]
}
